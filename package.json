{
  "name": "doomsday-cypher",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "DOOMSDAY CYPHER — a team-based CTF platform by the Deakin Research & Technology Club.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:remote": "vite --mode remote",
    "api:dev": "tsx src/server/dev.ts",
    "build": "tsc --noEmit && vite build",
    "build:api": "node scripts/build-api.mjs",
    "build:vercel": "npm run build:api && vite build --mode vercel",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/bebas-neue": "^5.1.0",
    "@fontsource/ibm-plex-mono": "^5.1.0",
    "@fontsource/inter": "^5.1.0",
    "framer-motion": "^11.11.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.24.0",
    "playwright-core": "^1.48.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
